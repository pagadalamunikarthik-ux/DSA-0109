#include <iostream>
using namespace std;

int main()
{
    int n, sum;

    cout << "Enter a number: ";
    cin >> n;

    while (n > 9)
    {
        sum = 0;
        while (n > 0)
        {
            sum += n % 10;
            n /= 10;
        }
        n = sum;
    }

    cout << "Digital Root = " << n;

    return 0;
}
